{
  "name": "loanflow",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",

  "scripts": {
    "build:frontend": "cd frontend && npm run build",
    "dist": "npm run build:frontend && electron-builder",
    "dist:win": "npm run build:frontend && electron-builder --win",
    "dist:mac": "npm run build:frontend && electron-builder --mac"
  },

  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },

  "build": {
    "appId": "com.loanflow.desktop",
    "productName": "LoanFlow",

    "directories": {
      "output": "release"
    },

    "files": [
      "electron/**/*",
      "frontend/dist/**/*"
    ],

    "extraResources": [
      {
        "from": "backend/dist/loneflow_analyzer",
        "to": "backend/loneflow_analyzer"
      }
    ],

    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/loanflow_icon.icns"
    },

    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/loanflow_icon.ico"
    }
  }
}